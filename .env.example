DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/magang"
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# akun admin awal yang dibuat oleh `npm run db:seed`
ADMIN_EMAIL="admin@magang.local"
ADMIN_PASSWORD="ganti-password-ini"

# URL publik aplikasi (opsional), mis. https://magang.contoh.id — untuk metadata/OG
APP_URL=""

# Folder penyimpanan file unggahan (lokal). Default: ./storage
# STORAGE_DIR="storage"

# Maks. koneksi database per proses (opsional, default 10)
# DATABASE_POOL_MAX="10"

# Notifikasi push (opsional). Buat dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kantor.id"

# Rahasia untuk endpoint pengingat terjadwal /api/cron/pengingat (string acak panjang)
CRON_SECRET=""
