generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // admin utama magang
  TEAM_ADMIN // admin per tim
  INTERN
}

enum InternshipType {
  MANDIRI
  MAGANGHUB // program MagangHub, untuk yang sudah lulus
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT // hadir tepat waktu
  LATE // hadir terlambat
  PERMIT // izin
  SICK // sakit
}

enum ActivityType {
  WORK
  NOT_WORK
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(INTERN)
  isActive          Boolean   @default(true)
  // Sesi yang dibuat sebelum waktu ini ditolak (setelah ganti/reset password).
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Hanya untuk TEAM_ADMIN: tim yang dikelola.
  teamId String?
  team   Team?   @relation("TeamAdmins", fields: [teamId], references: [id], onDelete: SetNull)

  profile       Profile?
  registrations Registration[]
  attendances   Attendance[]
  activities    Activity[]
  evaluations   Evaluation[]     @relation("EvaluationIntern")
  evaluationsBy Evaluation[]     @relation("EvaluationEvaluator")
  notifications Notification[]
  surveys       SurveyResponse[]

  @@index([teamId])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isOpen      Boolean  @default(true) // tampil & bisa dipilih saat pendaftaran
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins        User[]         @relation("TeamAdmins")
  registrations Registration[]
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  phone       String?
  institution String? // asal sekolah / kampus
  major       String? // jurusan
  studentId   String? // NIM / NIS
  birthDate   DateTime? @db.Date
  address     String?
  bio         String?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Registration {
  id             String             @id @default(cuid())
  userId         String
  teamId         String
  type           InternshipType     @default(MANDIRI)
  graduationYear Int? // wajib untuk MAGANGHUB
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  motivation     String
  status         RegistrationStatus @default(PENDING)
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  evaluations Evaluation[]
  survey      SurveyResponse?
  certificate Certificate?

  @@index([userId])
  @@index([status])
  @@index([teamId])
}

model Evaluation {
  id             String   @id @default(cuid())
  registrationId String
  internId       String
  evaluatorId    String?
  month          DateTime @db.Date // tanggal 1 bulan yang dinilai

  discipline    Int // kedisiplinan
  workQuality   Int // kualitas kerja
  communication Int // komunikasi
  initiative    Int // inisiatif
  teamwork      Int // kerja sama
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  intern       User         @relation("EvaluationIntern", fields: [internId], references: [id], onDelete: Cascade)
  evaluator    User?        @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@unique([registrationId, month])
  @@index([internId])
  @@index([month])
}

model OfficeSetting {
  id           Int    @id @default(1)
  name         String @default("Kantor Pusat")
  latitude     Float  @default(-6.2088)
  longitude    Float  @default(106.8456)
  radiusMeters Int    @default(150)
  workStart    String @default("08:00") // jam masuk (WIB)
  lateAfter    String @default("08:15") // lewat jam ini dianggap terlambat
  workEnd      String @default("16:00")

  // Sertifikat
  orgName     String   @default("Portal Magang")
  certCity    String   @default("Jakarta")
  signerName  String   @default("")
  signerTitle String   @default("Koordinator Program Magang")
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  status AttendanceStatus

  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInDistance Float? // meter dari titik kantor

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutDistance Float?

  note      String? // alasan untuk izin / sakit
  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([userId, date])
  @@index([date])
}

model Activity {
  id           String       @id @default(cuid())
  userId       String
  attendanceId String
  date         DateTime     @db.Date
  type         ActivityType
  title        String
  description  String?
  createdAt    DateTime     @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
}

enum AttemptKind {
  LOGIN
  REGISTER
}

// Catatan percobaan login/daftar untuk membatasi brute force. Baris lama dibersihkan otomatis.
model AuthAttempt {
  id        String      @id @default(cuid())
  kind      AttemptKind
  key       String // email (huruf kecil) untuk LOGIN, IP untuk REGISTER
  ip        String?
  success   Boolean
  createdAt DateTime    @default(now())

  @@index([kind, key, createdAt])
  @@index([kind, ip, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  REGISTRATION_SUBMITTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  ABSENCE_REPORTED
  EVALUATION_PUBLISHED
  SURVEY_REMINDER
  CERTIFICATE_ISSUED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  refId     String? // id objek terkait, untuk mencegah pengingat ganda
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, type, refId])
}

// Survei akhir magang, syarat terbitnya sertifikat. Nilai 1–5.
model SurveyResponse {
  id             String   @id @default(cuid())
  registrationId String   @unique
  userId         String
  overall        Int // kepuasan keseluruhan
  relevance      Int // kesesuaian tugas dengan minat/jurusan
  mentoring      Int // bimbingan admin tim/mentor
  environment    Int // lingkungan & fasilitas kerja
  recommend      Int // kesediaan merekomendasikan
  highlights     String // hal paling bermanfaat
  suggestions    String? // saran perbaikan
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certificate {
  id             String   @id @default(cuid())
  registrationId String   @unique
  number         String   @unique // mis. 007/MAGANG/XI/2026
  code           String   @unique // kode verifikasi publik
  issuedAt       DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
